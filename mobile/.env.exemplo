# Copie para .env (fica fora do git). Só valores públicos: o app nunca recebe a chave secret.

# Painel do Supabase > Project Settings > API Keys
EXPO_PUBLIC_SUPABASE_URL=https://<id-do-projeto>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<chave publishable, começa com sb_publishable_>

# Endereço do servidor PHP (sem /api no fim). No celular, use o IP do computador na rede,
# por exemplo http://192.168.0.10:8001 (o iOS fora do modo de desenvolvimento exige HTTPS).
EXPO_PUBLIC_API_URL=http://localhost:8001
