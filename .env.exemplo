# Copie este arquivo para .env e preencha com os dados do projeto no Supabase.
# O .env fica fora do git: a chave secret ignora todas as regras de acesso.

# Painel > Connect > "Session pooler" (porta 5432), exatamente como aparece, com a senha do banco.
DATABASE_URL=postgresql://postgres.<id-do-projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Painel > Project Settings > API Keys
SUPABASE_URL=https://<id-do-projeto>.supabase.co
SUPABASE_SECRET_KEY=<chave secret, começa com sb_secret_>

# Opcional. Chave pública (sb_publishable_...), a mesma que o aplicativo usa para o login.
# Usada pelo ferramentas/testar_api.ps1; sem ela, o script usa a chave secret.
SUPABASE_PUBLISHABLE_KEY=<chave publishable, começa com sb_publishable_>
